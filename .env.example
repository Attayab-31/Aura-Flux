# =============================================================================
# ENVIRONMENT CONFIGURATION: AI VIDEO GENERATION CONTROL PLANE
# =============================================================================

# Flask Application Settings
PORT=5000
FLASK_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Use true for HTTPS deployments; false is only for localhost HTTP.
SESSION_COOKIE_SECURE=false

# Optional local/paid-host persistent disk paths; Render Free has no persistent disk.
# Example: PERSISTENT_DATA_DIR=/mnt/fluxstory PERSISTENT_TEMP_DIR=/mnt/fluxstory/temp
PERSISTENT_DATA_DIR=
PERSISTENT_TEMP_DIR=
# For Render free deployments use Supabase instead of the ephemeral local SQLite/file store.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fluxstory-media
# The durable SQLite queue capacity is 100 waiting user jobs; one consumer runs.

# Finite on-demand Kaggle batches. Review Kaggle rules and account limits before enabling.
KAGGLE_BATCH_AUTOSTART=false
KAGGLE_API_TOKEN=
# Legacy Kaggle CLI auth only if API token auth is unavailable.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_ID=owner/fluxstory-on-demand-worker
KAGGLE_KERNEL_PATH=workers/kaggle_fluxstory
KAGGLE_BATCH_ACCELERATOR=NvidiaTeslaT4
KAGGLE_BATCH_TIMEOUT_SECONDS=14400
KAGGLE_BATCH_DEBOUNCE_SECONDS=10
KAGGLE_BATCH_IDLE_EXIT_SECONDS=45
KAGGLE_BATCH_MAX_RUNTIME_SECONDS=14400
KAGGLE_BATCH_MAX_STARTS_PER_DAY=6
# 0 disables the optional weekly runtime cap. Configure according to account quota.
KAGGLE_BATCH_MAX_RUNTIME_PER_WEEK_SECONDS=0
KAGGLE_BATCH_POLL_SECONDS=60
WORKER_CALLBACK_TOKEN=
GPU_REQUEST_MAX_PENDING=500
GPU_REQUEST_LEASE_SECONDS=900
GPU_REQUEST_MAX_ATTEMPTS=3
# Optional old synchronous URL mode is retained only for direct debugging.
KAGGLE_WORKER_URL=
KAGGLE_WORKER_TOKEN=
IMAGE_WORKER_CONNECT_TIMEOUT=5
IMAGE_WORKER_READ_TIMEOUT=180
IMAGE_WORKER_MAX_RETRIES=3
IMAGE_WORKER_RETRY_BASE_SECONDS=2

# Deepgram Aura Text-to-Speech API
# Format: Token <your_deepgram_api_key> or just the key string
DEEPGRAM_API_KEY=
DEFAULT_TTS_VOICE=aura-2-thalia-en

# Large Language Model (Director Service)
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# OpenAI-compatible custom endpoint. Use together with CUSTOM_LLM_API_KEY.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
DEFAULT_LLM_MODEL=gemini-3.8-flash
# Tried in order after the primary provider/model above. Format: provider:model, comma-separated.
# Providers without a configured key (or custom URL/key) are skipped. Rule-based planning runs last.
LLM_FALLBACKS=openai:gpt-4o-mini,groq:openai/gpt-oss-20b

# Video Rendering Configuration
DEFAULT_FPS=30
CROSSFADE_BUFFER=1.0
