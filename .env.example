# FluxStory production configuration reference.
# This project does not load .env files at runtime. Copy the applicable values
# into Render Dashboard > Environment. Never commit real secrets.

# Flask security (required; use a random secret of at least 32 characters)
SECRET_KEY=

# Supabase database and private media bucket (required)
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fluxstory-media

# Text generation. Supported providers: openai, gemini, groq, custom.
# Fallbacks are ordered provider:model pairs, comma separated, e.g. groq:llama-3.3-70b-versatile
LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
LLM_FALLBACKS=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# Narration
DEEPGRAM_API_KEY=
DEFAULT_TTS_VOICE=aura-2-thalia-en

# Video output tuning
DEFAULT_FPS=30
CROSSFADE_BUFFER=1.0
# Target scene length is fixed at 7 seconds in config.py.

# Kaggle batch GPU worker (Render settings)
# Enable only after Kaggle credentials, notebook secrets, and callback URL are configured.
KAGGLE_BATCH_AUTOSTART=false
KAGGLE_API_TOKEN=
KAGGLE_KERNEL_ID=your-kaggle-username/your-notebook-slug
KAGGLE_BATCH_ACCELERATOR=NvidiaTeslaT4
KAGGLE_BATCH_TIMEOUT_SECONDS=14400
KAGGLE_BATCH_DEBOUNCE_SECONDS=10
# These two are dispatcher watchdog/status values; they do not set Kaggle notebook timers.
KAGGLE_BATCH_IDLE_EXIT_SECONDS=45
KAGGLE_BATCH_MAX_RUNTIME_SECONDS=14400
KAGGLE_BATCH_MAX_STARTS_PER_DAY=6
# 0 means no weekly runtime cap.
KAGGLE_BATCH_MAX_RUNTIME_PER_WEEK_SECONDS=0
KAGGLE_BATCH_POLL_SECONDS=60
WORKER_CALLBACK_TOKEN=

# GPU request queue and recovery tuning
GPU_REQUEST_MAX_PENDING=500
GPU_REQUEST_LEASE_SECONDS=900
GPU_REQUEST_MAX_ATTEMPTS=3

# Configure these as Kaggle Notebook Secrets, not Render variables:
# FLASK_WORKER_BASE_URL=https://your-render-service.onrender.com
# WORKER_CALLBACK_TOKEN=same-secret-as-Render
# WORKER_IDLE_EXIT_SECONDS=45
# WORKER_MAX_RUNTIME_SECONDS=14400
# WORKER_POLL_INTERVAL_SECONDS=2
# WORKER_HTTP_TIMEOUT_SECONDS=45
